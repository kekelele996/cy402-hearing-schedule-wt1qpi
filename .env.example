# Docker Compose 项目名，同时作为容器名前缀
COMPOSE_PROJECT_NAME=cylawcase

# PostgreSQL 数据库配置
DB_NAME=cylawcase_db
DB_USER=cylawcase_user
DB_PASSWORD=cylawcase_pwd
DB_ROOT_PASSWORD=cylawcase_root

# 后端
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE_HOURS=72

# 端口映射
FRONTEND_PORT=28031
BACKEND_PORT=29069
DB_PORT=38102
